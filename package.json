{
	"name": "obsidian-task-overview",
	"version": "1.0.1",
	"description": "Lists the tasks of the note in focus, filtered by open or completed, and optionally grouped under their headings.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tasks"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"esbuild": "^0.20.2",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	}
}
